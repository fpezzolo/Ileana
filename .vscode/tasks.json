{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "scripts/lint.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "scripts/test.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "Lint + Test",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "scripts/lint-test.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
